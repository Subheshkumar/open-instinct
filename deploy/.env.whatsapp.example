# Copy to deploy/.env.whatsapp and fill in your deployment values.
# This file configures the gateway. Agents receive only their own private reply token.
PORT=8787
GATEWAY_PUBLIC_URL=https://rex.example.com
GATEWAY_DATA_DIR=/data

# Maritime key with provisioning, deployment, secrets and deletion permissions.
MARITIME_API_KEY=
# Build/publish deploy/Dockerfile.agent from YOUR copy of this repository.
INSTINCT_AGENT_IMAGE=ghcr.io/your-org/open-instinct-agent:latest
INSTINCT_IDLE_TTL_SECONDS=900

# Model/provider available in this repo's Pi model catalog. Leave blank for the repo default.
INSTINCT_MODEL=
ANTHROPIC_API_KEY=
# Alternatively OPENAI_API_KEY, GEMINI_API_KEY or GROQ_API_KEY.
# For openai-compatible/<model>, also set OPENAI_BASE_URL.
INSTINCT_OWNER_TIMEZONE=Asia/Kolkata

# Meta Cloud API configuration. Use a supported Graph API version from your Meta dashboard.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
# Your bot's actual number, with country code. Optional: enables landing/invite wa.me links.
# Invite links prefill JOIN <token>; without this number, recipients copy JOIN manually.
WHATSAPP_PUBLIC_NUMBER=

# Optional initial members for a clean install: comma-separated numbers with full country codes.
# Example: +919876543210,+14155550123. Verified messages from these numbers receive Rex access.
# Existing WhatsApp records are admitted once on upgrade; other new senders require a referral.
# Members send REFERRAL for one reusable link admitting up to five distinct senders total.
# LOGOUT blocks chat and agent replies; LOGIN resumes an existing membership.
WHATSAPP_BOOTSTRAP_NUMBERS=

# Per-user daily admission limits reset at midnight UTC. Persisted across restarts.
WHATSAPP_MESSAGES_PER_DAY=100
WHATSAPP_REPLIES_PER_DAY=300
# Total active accounts and new-account creation in a rolling hour.
WHATSAPP_MAX_USERS=100
WHATSAPP_NEW_USERS_PER_HOUR=20

# Purchase caps in USD, per private agent. All positive purchases ask for approval.
INSTINCT_SPEND_PER_ACTION_USD=25
INSTINCT_SPEND_PER_DAY_USD=50
INSTINCT_SPEND_ASK_ABOVE_USD=0

# Optional approved template with ONE body text parameter for notifications after the 24-hour reply window.
WHATSAPP_NOTIFICATION_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en

# Optional user app connections. Each user receives a distinct Composio identity.
COMPOSIO_API_KEY=
COMPOSIO_TOOLKITS=gmail,googlecalendar,googlecontacts
# Optional improved web search.
BRAVE_SEARCH_API_KEY=
